,"          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"print(\\\"Scaling and selection will be done AFTER the train/test split so we do not leak test information\",\n  \"rows\": 5,\n  \"fields\": [\n    {\n      \"column\": \"TenureRatio\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.39678394116399734,\n        \"min\": 0.0,\n        \"max\": 0.9090909090909091,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          0.9090909090909091,\n          0.2857142857142857,\n          0.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"AgeWhenStarted\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 6,\n        \"min\": 21,\n        \"max\": 39,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          39,\n          21,\n          30\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"YearsPerCompany\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2.0464120966061072,\n        \"min\": 0.6,\n        \"max\": 5.0,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          5.0,\n          0.6,\n          1.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"AvgSatisfaction\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.5,\n        \"min\": 2.0,\n        \"max\": 3.25,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          3.0,\n          2.5,\n          2.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"LogDistanceFromHome\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.5616285883044041,\n        \"min\": 0.6931471805599453,\n        \"max\": 2.1972245773362196,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          2.1972245773362196,\n          1.3862943611198906,\n          0.6931471805599453\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Shape after encoding: (1470, 47)\n","Encoding turned text columns into 0/1 columns. Example new column names:\n","['Department_Research & Development', 'Department_Sales', 'JobRole_Human Resources', 'JobRole_Laboratory Technician', 'JobRole_Manager', 'JobRole_Manufacturing Director', 'JobRole_Research Director', 'JobRole_Research Scientist']\n","\n","✅ Feature transformation + encoding complete.\n","Scaling and selection will be done AFTER the train/test split so we do not leak test information.\n"]}],"source":["data = df_clean.copy()\n","\n","# ---------- 1) TRANSFORMATION : new features that a human would also think of ----------\n","# How much of the career has been spent at THIS company?\n","data[\"TenureRatio\"] = data[\"YearsAtCompany\"] / (data[\"TotalWorkingYears\"] + 1)\n","\n","# Rough age when the person started working\n","data[\"AgeWhenStarted\"] = (data[\"Age\"] - data[\"TotalWorkingYears\"]).clip(lower=16)\n","\n","# Life at work vs life commuting\n","data[\"YearsPerCompany\"] = data[\"TotalWorkingYears\"] / (data[\"NumCompaniesWorked\"] + 1)\n","\n","# Satisfaction average (simple combination of related ordinal scores)\n","data[\"AvgSatisfaction\"] = data[\n","    [\"EnvironmentSatisfaction\", \"JobSatisfaction\", \"RelationshipSatisfaction\", \"WorkLifeBalance\"]\n","].mean(axis=1)\n","\n","# Log transform: income and distance are skewed (long tail on the right).\n","# log1p(x) = log(1 + x), safe even if x is 0.\n","data[\"LogDistanceFromHome\"] = np.log1p(data[\"DistanceFromHome\"])\n","\n","print(\"New engineered columns (first 5 rows):\")\n","display(data[[\"TenureRatio\", \"AgeWhenStarted\", \"YearsPerCompany\", \"AvgSatisfaction\", \"LogDistanceFromHome\"]].head())\n","\n","# ---------- 2) ENCODING : text → numbers ----------\n","# Binary Yes/No columns\n","data[\"AttritionFlag\"] = data[\"Attrition\"].map({\"Yes\": 1, \"No\": 0})\n","data[\"OverTimeFlag\"] = data[\"OverTime\"].map({\"Yes\": 1, \"No\": 0})\n","data[\"GenderFlag\"] = data[\"Gender\"].map({\"Male\": 1, \"Female\": 0})\n","\n","# One-hot encoding for columns with several categories\n","# drop_first=True avoids duplicate information (if not Sales and not HR, it must be R&D)\n","one_hot_cols = [\"BusinessTravel\", \"Department\", \"EducationField\", \"JobRole\", \"MaritalStatus\"]\n","data_encoded = pd.get_dummies(data, columns=one_hot_cols, drop_first=True)\n","\n","# We can now drop the original text columns we already encoded\n","data_encoded = data_encoded.drop(columns=[\"Attrition\", \"OverTime\", \"Gender\"])\n","\n","print(\"\\nShape after encoding:\", data_encoded.shape)\n","print(\"Encoding turned text columns into 0/1 columns. Example new column names:\")\n","print([c for c in data_encoded.columns if any(x in c for x in [\"JobRole_\", \"Department_\", \"MaritalStatus_\"])][:8])\n","\n","print(\"\\n✅ Feature transformation + encoding complete.\")\n","print(\"Scaling and selection will be done AFTER the train/test split so we do not leak test information.\")\n"]},{"cell_type":"markdown","id":"9bb98f05","metadata":{"id":"9bb98f05"},"source":["## Cell 8 — Unsupervised learning: PCA + K-Means\n","\n","We **hide the answers** (attrition, salary) and ask: *are there natural employee groups?*\n","\n","**PCA (Principal Component Analysis)**  \n","Compresses many numeric columns into 2 new axes so we can **draw** employees on a scatter plot.\n","\n","**K-Means**  \n","Puts employees into K groups of similar people. We try several K and pick a reasonable one with the **elbow** and **silhouette** scores.\n","\n","This is unsupervised because the algorithm never sees `Attrition`.\n"]},{"cell_type":"code","execution_count":9,"id":"a752b16e","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"a752b16e","executionInfo":{"status":"ok","timestamp":1787223419662,"user_tz":-330,"elapsed":4327,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"6dd3d596-2544-4a98-ed1a-c2a5f485be95"},"outputs":[{"output_type":"stream","name":"stdout","text":["PCA explained variance ratio (how much info each axis keeps):\n","[0.217 0.112]\n","Together they keep 0.329 of the numeric information.\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x400 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Silhouette is highest at K = 2. We will also show K = 3 because it is easy to explain to HR.\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","What kind of people are in each cluster? (mean values)\n"]},{"output_type":"display_data","data":{"text/plain":["           Age  MonthlyIncome  TotalWorkingYears  YearsAtCompany  OverTimeFlag  AvgSatisfaction  AttritionFlag  Count\n","Cluster                                                                                                              \n","0        35.93        6063.06              11.66           10.23          0.26             2.74           0.10    442\n","1        48.20       15518.77              25.52           14.41          0.28             2.76           0.08    220\n","2        34.40        4288.75               7.19            3.23          0.30             2.72           0.22    808"],"text/html":["\n","  <div id=\"df-69353616-22ad-4a60-89da-f4436d6a0738\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Age</th>\n","      <th>MonthlyIncome</th>\n","      <th>TotalWorkingYears</th>\n","      <th>YearsAtCompany</th>\n","      <th>OverTimeFlag</th>\n","      <th>AvgSatisfaction</th>\n","      <th>AttritionFlag</th>\n","      <th>Count</th>\n","    </tr>\n","    <tr>\n","      <th>Cluster</th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>35.93</td>\n","      <td>6063.06</td>\n","      <td>11.66</td>\n","      <td>10.23</td>\n","      <td>0.26</td>\n","      <td>2.74</td>\n","      <td>0.10</td>\n","      <td>442</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>48.20</td>\n","      <td>15518.77</td>\n","      <td>25.52</td>\n","      <td>14.41</td>\n","      <td>0.28</td>\n","      <td>2.76</td>\n","      <td>0.08</td>\n","      <td>220</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>34.40</td>\n","      <td>4288.75</td>\n","      <td>7.19</td>\n","      <td>3.23</td>\n","      <td>0.30</td>\n","      <td>2.72</td>\n","      <td>0.22</td>\n","      <td>808</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>\n","    <div class=\"colab-df-buttons\">\
le('cluster_profile')\"\n","            title=\"Generate code using this dataframe.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\"viewBox=\"0 0 24 24\"\n","       width=\"24px\">\n","    <path d=\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\"/>\n","  </svg>\n","    </button>\n","    <script>\n","      (() => {\n","      const buttonEl =\n","        document.querySelector('#id_b57aff92-deec-49c4-8f3a-63553a5d7831 button.colab-df-generate');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () => {\n","        google.colab.notebook.generateWithVariable('cluster_profile');\n","      }\n","      })();\n","    </script>\n","  </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"cluster_profile","summary":"{\n  \"name\": \"cluster_profile\",\n  \"rows\": 3,\n  \"fields\": [\n    {\n      \"column\": \"Cluster\",\n      \"properties\": {\n        \"dtype\": \"int32\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          0,\n          1,\n          2\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Age\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 7.564542286219308,\n        \"min\": 34.4,\n        \"max\": 48.2,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          35.93,\n          48.2,\n          34.4\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"MonthlyIncome\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 6036.996725478102,\n        \"min\": 4288.75,\n        \"max\": 15518.77,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          6063.06,\n          15518.77,\n          4288.75\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"TotalWorkingYears\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 9.557452589471737,\n        \"min\": 7.19,\n        \"max\": 25.52,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          11.66,\n          25.52,\n          7.19\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"YearsAtCompany\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 5.648964506880884,\n        \"min\": 3.23,\n        \"max\": 14.41,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          10.23,\n          14.41,\n          3.23\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"OverTimeFlag\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.01999999999999999,\n        \"min\": 0.26,\n        \"max\": 0.3,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          0.26,\n          0.28,\n          0.3\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"AvgSatisfaction\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.019999999999999796,\n        \"min\": 2.72,\n        \"max\": 2.76,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          2.74,\n          2.76,\n          2.72\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"AttritionFlag\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.07571877794400365,\n        \"min\": 0.08,\n        \"max\": 0.22,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          0.1,\n          0.08,\n          0.22\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Count\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 296,\n        \"min\": 220,\n        \"max\": 808,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          442,\n          220,\n          808\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","💡 How to read this:\n"," - A cluster with high OverTimeFlag and high AttritionFlag is a retention-risk group.\n"," - A cluster with high income + high years at company is usually a stable senior group.\n"," - PCA/K-Means did not use Attrition to form groups. If attrition still differs by cluster,\n","   that is a real structure in the data — powerful for an interview answer.\n"]}],"source":["# Use only numeric original-style features for clustering (no dummy explosion, easier to interpret)\n","cluster_features = [\n","    \"Age\", \"DistanceFromHome\", \"Education\", \"EnvironmentSatisfaction\",\n","    \"JobInvolvement\", \"JobLevel\", \"JobSatisfaction\", \"MonthlyIncome\",\n","    \"NumCompaniesWorked\", \"PercentSalaryHike\", \"PerformanceRating\",\n","    \"StockOptionLevel\", \"TotalWorkingYears\", \"TrainingTimesLastYear\",\n","    \"WorkLifeBalance\", \"YearsAtCompany\", \"YearsInCurrentRole\",\n","    \"YearsSinceLastPromotion\", \"YearsWithCurrManager\",\n","    \"TenureRatio\", \"AvgSatisfaction\", \"OverTimeFlag\",\n","]\n","\n","X_unsup = data[cluster_features].copy()\n","\n","# Scaling is REQUIRED for PCA and K-Means (otherwise income in thousands would dominate age in years)\n","scaler_unsup = StandardScaler()\n","X_unsup_scaled = scaler_unsup.fit_transform(X_unsup)\n","\n","# ----- PCA to 2D for visualization -----\n","pca = PCA(n_components=2, random_state=42)\n","X_pca = pca.fit_transform(X_unsup_scaled)\n","\n","print(\"PCA explained variance ratio (how much info each axis keeps):\")\n","print(pca.explained_variance_ratio_.round(3))\n","print(\"Together they keep\", pca.explained_variance_ratio_.sum().round(3), \"of the numeric information.\")\n","\n","# ----- choose K for K-Means -----\n","inertias, silhouettes, ks = [], [], range(2, 8)\n","for k in ks:\n","    km = KMeans(n_clusters=k, random_state=42, n_init=10)\n","    labels_k = km.fit_predict(X_unsup_scaled)\n","    inertias.append(km.inertia_)\n","    silhouettes.append(silhouette_score(X_unsup_scaled, labels_k))\n","\n","fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n","axes[0].plot(list(ks), inertias, marker=\"o\")\n","axes[0].set_title(\"Elbow plot (look for a bend)\")\n","axes[0].set_xlabel(\"K clusters\")\n","axes[0].set_ylabel(\"Inertia (lower = tighter clusters)\")\n","axes[1].plot(list(ks), silhouettes, marker=\"o\", color=\"teal\")\n","axes[1].set_title(\"Silhouette score (higher = clearer clusters)\")\n","axes[1].set_xlabel(\"K clusters\")\n","plt.tight_layout()\n","plt.show()\n","\n","best_k = int(list(ks)[int(np.argmax(silhouettes))])\n","print(f\"Silhouette is highest at K = {best_k}. We will also show K = 3 because it is easy to explain to HR.\")\n","\n","# Use K=3 for a story HR can understand (even if silhouette prefers another K)\n","k_used = 3\n","kmeans = KMeans(n_clusters=k_used, random_state=42, n_init=10)\n","data[\"Cluster\"] = kmeans.fit_predict(X_unsup_scaled)\n","\n","fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n","sns.scatterplot(x=X_pca[:, 0], y=X_pca[:, 1], hue=data[\"Attrition\"], ax=axes[0], palette=[\"#4caf50\", \"#e53935\"])\n","axes[0].set_title(\"PCA (2D) colored by Attrition (the label was NOT used to build PCA)\")\n","axes[0].set_xlabel(\"PC1\")\n","axes[0].set_ylabel(\"PC2\")\n","\n","sns.scatterplot(x=X_pca[:, 0], y=X_pca[:, 1], hue=data[\"Cluster\"], ax=axes[1], palette=\"Set2\")\n","axes[1].set_title(f\"PCA (2D) colored by K-Means clusters (K={k_used})\")\n","axes[1].set_xlabel(\"PC1\")\n","axes[1].set_ylabel(\"PC2\")\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"\\nWhat kind of people are in each cluster? (mean values)\")\n","cluster_profile = data.groupby(\"Cluster\")[\n","    [\"Age\", \"MonthlyIncome\", \"TotalWorkingYears\", \"YearsAtCompany\", \"OverTimeFlag\", \"AvgSatisfaction\", \"AttritionFlag\"]\n","].mean().round(2)\n","cluster_profile[\"Count\"] = data.groupby(\"Cluster\").size()\n","display(cluster_profile)\n","\n","print(\"\\n💡 How to read this:\")\n","print(\" - A cluster with high OverTimeFlag and high AttritionFlag is a retention-risk group.\")\n","print(\" - A cluster with high income + high years at company is usually a stable senior group.\")\n","print(\" - PCA/K-Means did not use Attrition to form groups. If attrition still differs by cluster,\")\n","print(\"   that is a real structure in the data — powerful for an interview answer.\")\n"]},{"cell_type":"markdown","id":"0f80edf9","metadata":{"id":"0f80edf9"},"source":["## Cell 9 — Helper: train/test split, scaling, feature selection\n","\n","### Why split?\n","If we train and test on the **same** people, the model can memorize them. That is cheating.  \n","We hide 20% of employees as a **test set** (final exam).\n","\n","### Why scale AFTER the split?\n","`StandardScaler` learns mean and standard deviation.  \n","Those must come from the **training** set only. Otherwise the test set leaks into training.\n","\n","### Feature selection\n","`SelectKBest` scores each column against the target and keeps the top K.  \n","We will print the winners so you can talk about them.\n"]},{"cell_type":"code","execution_count":10,"id":"8f73569c","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8f73569c","executionInfo":{"status":"ok","timestamp":1787223436128,"user_tz":-330,"elapsed":98,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"110db6a2-54cd-4fd2-cedb-beb07d42f1cd"},"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Helper functions are ready. Next we train regression models.\n"]}],"source":["def scale_train_test(X_train, X_test, method=\"standard\"):\n","    \"\"\"Fit scaler on TRAIN, then transform both. Never fit on test.\"\"\"\n","    scaler = StandardScaler() if method == \"standard\" else MinMaxScaler()\n","    X_train_s = scaler.fit_transform(X_train)\n","    X_test_s = scaler.transform(X_test)\n","    # convert back to DataFrame so column names stay (easier to read coefficients later)\n","    X_train_s = pd.DataFrame(X_train_s, columns=X_train.columns, index=X_train.index)\n","    X_test_s = pd.DataFrame(X_test_s, columns=X_test.columns, index=X_test.index)\n","    return X_train_s, X_test_s, scaler\n","\n","\n","def show_select_kbest(X, y, k=12, problem=\"classification\"):\n","    score_func = f_classif if problem == \"classification\" else f_regression\n","    k = min(k, X.shape[1])\n","    selector = SelectKBest(score_func=score_func, k=k)\n","    selector.fit(X, y)\n","    scores = pd.Series(selector.scores_, index=X.columns).sort_values(ascending=False)\n","    print(f\"\\nSelectKBest ({problem}) — top {k} features:\")\n","    print(scores.head(k).round(2))\n","    mask = selector.get_support()\n","    return list(X.columns[mask]), scores\n","\n","\n","def regression_report(y_true, y_pred, name):\n","    mae = mean_absolute_error(y_true, y_pred)\n","    rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n","    r2 = r2_score(y_true, y_pred)\n","    print(f\"{name:28s}  MAE={mae:8.1f}   RMSE={rmse:8.1f}   R²={r2:6.3f}\")\n","    return {\"Model\": name, \"MAE\": mae, \"RMSE\": rmse, \"R2\": r2}\n","\n","\n","def classification_report_row(y_true, y_pred, y_prob, name):\n","    row = {\n","        \"Model\": name,\n","        \"Accuracy\": accuracy_score(y_true, y_pred),\n","        \"Precision\": precision_score(y_true, y_pred, zero_division=0),\n","        \"Recall\": recall_score(y_true, y_pred, zero_division=0),\n","        \"F1\": f1_score(y_true, y_pred, zero_division=0),\n","        \"ROC-AUC\": roc_auc_score(y_true, y_prob) if y_prob is not None else np.nan,\n","    }\n","    print(\n","        f\"{name:22s}  Acc={row['Accuracy']:.3f}  Prec={row['Precision']:.3f}  \"\n","        f\"Rec={row['Recall']:.3f}  F1={row['F1']:.3f}  AUC={row['ROC-AUC']:.3f}\"\n","    )\n","    return row\n","\n","\n","print(\"✅ Helper functions are ready. Next we train regression models.\")\n"]},{"cell_type":"markdown","id":"c0333cee","metadata":{"id":"c0333cee"},"source":["# PART A — REGRESSION\n","## Predict `MonthlyIncome` (compensation modeling)\n","\n","**Question:** Given experience, role, education, overtime… what monthly income is typical?\n","\n","**Models you studied, all used below**\n","- Linear Regression\n","- Polynomial Regression (and why high degree overfits)\n","- Ridge (L2 regularization → shrinks coefficients)\n","- Lasso (L1 regularization → can set some coefficients to exactly 0 = automatic feature selection)\n","\n","**Metrics**\n","- **MAE** — average absolute error in dollars (easy to explain to HR)\n","- **RMSE** — like MAE but punishes big mistakes more\n","- **R²** — 0 = useless, 1 = perfect explanation of salary variation\n"]},{"cell_type":"code","execution_count":11,"id":"0543bc8b","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0543bc8b","executionInfo":{"status":"ok","timestamp":1787223448515,"user_tz":-330,"elapsed":196,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"fcaf047b-54e7-4f1c-ae76-8b21b5edfb48"},"outputs":[{"output_type":"stream","name":"stdout","text":["Salary model X shape: (1470, 45)\n","Salary target stats:\n"," count     1470.000000\n","mean      6502.931293\n","std       4707.956783\n","min       1009.000000\n","25%       2911.000000\n","50%       4919.000000\n","75%       8379.000000\n","max      19999.000000\n","Name: MonthlyIncome, dtype: float64\n","\n","Train employees: 1176 | Test employees: 294\n","\n","SelectKBest (regression) — top 12 features:\n","JobLevel                         11257.55\n","TotalWorkingYears                 1732.95\n","JobRole_Manager                    682.16\n","YearsAtCompany                     427.43\n","Age                                395.76\n","JobRole_Research Director          393.90\n","YearsPerCompany                    303.38\n","YearsInCurrentRole                 203.77\n","JobRole_Research Scientist         163.46\n","YearsWithCurrManager               157.76\n","YearsSinceLastPromotion            155.41\n","JobRole_Laboratory Technician      131.40\n","dtype: float64\n","\n","Note: JobLevel and TotalWorkingYears usually dominate salary. That is expected.\n"]}],"source":["# Features for salary: everything encoded EXCEPT the salary itself and the attrition label\n","# (attrition is a future outcome; using it to set pay would be leaking a different problem)\n","salary_drop = [\"MonthlyIncome\", \"AttritionFlag\"]\n","X_sal = data_encoded.drop(columns=salary_drop)\n","y_sal = data_encoded[\"MonthlyIncome\"]\n","\n","print(\"Salary model X shape:\", X_sal.shape)\n","print(\"Salary target stats:\\n\", y_sal.describe())\n","\n","X_train_sal, X_test_sal, y_train_sal, y_test_sal = train_test_split(\n","    X_sal, y_sal, test_size=0.20, random_state=42\n",")\n","print(\"\\nTrain employees:\", X_train_sal.shape[0], \"| Test employees:\", X_test_sal.shape[0])\n","\n","# Scale — Linear / Ridge / Lasso / Polynomial all benefit from scaling\n","X_train_sal_s, X_test_sal_s, sal_scaler = scale_train_test(X_train_sal, X_test_sal, method=\"standard\")\n","\n","# Feature selection demo (does not change X yet; we just print winners)\n","top_sal_feats, sal_scores = show_select_kbest(X_train_sal_s, y_train_sal, k=12, problem=\"regression\")\n","print(\"\\nNote: JobLevel and TotalWorkingYears usually dominate salary. That is expected.\")\n"]},{"cell_type":"code","execution_count":12,"id":"baabc305","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":738},"id":"baabc305","executionInfo":{"status":"ok","timestamp":1787223461916,"user_tz":-330,"elapsed":3614,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"7cafa39c-c5cd-404f-e91e-e0cdb98f3f88"},"outputs":[{"output_type":"stream","name":"stdout","text":["========================================================================\n","REGRESSION MODELS  (trained on scaled features, evaluated on the HIDDEN test set)\n","========================================================================\n","Linear Regression             MAE=   896.2   RMSE=  1173.2   R²= 0.937\n","Ridge (alpha=7.85)            MAE=   892.3   RMSE=  1167.8   R²= 0.938\n","Lasso (alpha=26.37)           MAE=   888.9   RMSE=  1176.6   R²= 0.937\n","\n","Lasso set 25 of 45 coefficients to ~0  → it dropped those features.\n","\n","Polynomial demo features: ['Age', 'TotalWorkingYears', 'YearsAtCompany']\n","Polynomial degree 1  (  3 features)  Train R²=0.598   Test R²=0.599   gap=-0.000\n","Polynomial degree 1 (3 cols)  MAE=  2227.7   RMSE=  2961.0   R²= 0.599\n","Polynomial degree 2  (  9 features)  Train R²=0.602   Test R²=0.599   gap=0.003\n","Polynomial degree 2 (3 cols)  MAE=  2221.4   RMSE=  2961.0   R²= 0.599\n","Polynomial degree 4  ( 34 features)  Train R²=0.639   Test R²=0.592   gap=0.047\n","Polynomial degree 4 (3 cols)  MAE=  2210.9   RMSE=  2986.4   R²= 0.592\n","\n","Same degree-4 features, but with Ridge(alpha=50) to control variance:\n","  Train R²=0.615   Test R²=0.603\n","Poly d=4 + Ridge              MAE=  2221.0   RMSE=  2944.1   R²= 0.603\n","\n","===== REGRESSION LEADERBOARD (test set) =====\n"]},{"output_type":"display_data","data":{"text/plain":["<pandas.io.formats.style.Styler at 0x7a976117c5c0>"],"text/html":["<style type=\"text/css\">\n","</style>\n","<table id=\"T_17a73\" class=\"dataframe\">\n","  <thead>\n","    <tr>\n","      <th class=\"blank level0\" >&nbsp;</th>\n","      <th id=\"T_17a73_level0_col0\" class=\"col_heading level0 col0\" >Model</th>\n","      <th id=\"T_17a73_level0_col1\" class=\"col_heading level0 col1\" >MAE</th>\n","      <th id=\"T_17a73_level0_col2\" class=\"col_heading level0 col2\" >RMSE</th>\n","      <th id=\"T_17a73_level0_col3\" class=\"col_heading level0 col3\" >R2</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th id=\"T_17a73_level0_row0\" class=\"row_heading level0 row0\" >1</th>\n","      <td id=\"T_17a73_row0_col0\" class=\"data row0 col0\" >Ridge (alpha=7.85)</td>\n","      <td id=\"T_17a73_row0_col1\" class=\"data row0 col1\" >892.3</td>\n","      <td id=\"T_17a73_row0_col2\" class=\"data row0 col2\" >1167.8</td>\n","      <td id=\"T_17a73_row0_col3\" class=\"data row0 col3\" >0.938</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_17a73_level0_row1\" class=\"row_heading level0 row1\" >0</th>\n","      <td id=\"T_17a73_row1_col0\" class=\"data row1 col0\" >Linear Regression</td>\n","      <td id=\"T_17a73_row1_col1\" class=\"data row1 col1\" >896.2</td>\n","      <td id=\"T_17a73_row1_col2\" class=\"data row1 col2\" >1173.2</td>\n","      <td id=\"T_17a73_row1_col3\" class=\"data row1 col3\" >0.937</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_17a73_level0_row2\" class=\"row_heading level0 row2\" >2</th>\n","      <td id=\"T_17a73_row2_col0\" class=\"data row2 col0\" >Lasso (alpha=26.37)</td>\n","      <td id=\"T_17a73_row2_col1\" class=\"data row2 col1\" >888.9</td>\n","      <td id=\"T_17a73_row2_col2\" class=\"data row2 col2\" >1176.6</td>\n","      <td id=\"T_17a73_row2_col3\" class=\"data row2 col3\" >0.937</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_17a73_level0_row3\" class=\"row_heading level0 row3\" >6</th>\n","      <td id=\"T_17a73_row3_col0\" class=\"data row3 col0\" >Poly d=4 + Ridge</td>\n","      <td id=\"T_17a73_row3_col1\" class=\"data row3 col1\" >2221.0</td>\n","      <td id=\"T_17a73_row3_col2\" class=\"data row3 col2\" >2944.1</td>\n","      <td id=\"T_17a73_row3_col3\" class=\"data row3 col3\" >0.603</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_17a73_level0_row4\" class=\"row_heading level0 row4\" >4</th>\n","      <td id=\"T_17a73_row4_col0\" class=\"data row4 col0\" >Polynomial degree 2 (3 cols)</td>\n","      <td id=\"T_17a73_row4_col1\" class=\"data row4 col1\" >2221.4</td>\n","      <td id=\"T_17a73_row4_col2\" class=\"data row4 col2\" >2961.0</td>\n","      <td id=\"T_17a73_row4_col3\" class=\"data row4 col3\" >0.599</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_17a73_level0_row5\" class=\"row_heading level0 row5\" >3</th>\n","      <td id=\"T_17a73_row5_col0\" class=\"data row5 col0\" >Polynomial degree 1 (3 cols)</td>\n","      <td id=\"T_17a73_row5_col1\" class=\"data row5 col1\" >2227.7</td>\n","      <td id=\"T_17a73_row5_col2\" class=\"data row5 col2\" >2961.0</td>\n","      <td id=\"T_17a73_row5_col3\" class=\"data row5 col3\" >0.599</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_17a73_level0_row6\" class=\"row_heading level0 row6\" >5</th>\n","      <td id=\"T_17a73_row6_col0\" class=\"data row6 col0\" >Polynomial degree 4 (3 cols)</td>\n","      <td id=\"T_17a73_row6_col1\" class=\"data row6 col1\" >2210.9</td>\n","      <td id=\"T_17a73_row6_col2\" class=\"data row6 col2\" >2986.4</td>\n","      <td id=\"T_17a73_row6_col3\" class=\"data row6 col3\" >0.592</td>\n","    </tr>\n","  </tbody>\n","</table>\n"]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","💡 How to read the polynomial lines:\n"," - Degree 1: high bias, train ≈ test (underfit if R² is low).\n"," - High degree: train R² goes UP, test R² often goes DOWN → high variance (overfit).\n"," - Ridge on the high-degree features pulls train and test closer together.\n"]}],"source":["print(\"=\" * 72)\n","print(\"REGRESSION MODELS  (trained on scaled features, evaluated on the HIDDEN test set)\")\n","print(\"=\" * 72)\n","\n","reg_rows = []\n","\n","# ----- 1. Linear Regression -----\n","lin = LinearRegression()\n","lin.fit(X_train_sal_s, y_train_sal)\n","pred_lin = lin.predict(X_test_sal_s)\n","reg_rows.append(regression_report(y_test_sal, pred_lin, \"Linear Regression\"))\n","\n","# ----- 2. Ridge (L2) with built-in alpha search -----\n","# alpha = strength of penalty. Bigger alpha = simpler model (higher bias, lower variance)\n","ridge = RidgeCV(alphas=np.logspace(-2, 3, 20), cv=5)\n","ridge.fit(X_train_sal_s, y_train_sal)\n","pred_ridge = ridge.predict(X_test_sal_s)\n","reg_rows.append(regression_report(y_test_sal, pred_ridge, f\"Ridge (alpha={ridge.alpha_:.2f})\"))\n","\n","# ----- 3. Lasso (L1) with built-in alpha search -----\n","lasso = LassoCV(alphas=np.logspace(-2, 3, 20), cv=5, max_iter=8000, random_state=42)\n","lasso.fit(X_train_sal_s, y_train_sal)\n","pred_lasso = lasso.predict(X_test_sal_s)\n","reg_rows.append(regression_report(y_test_sal, pred_lasso, f\"Lasso (alpha={lasso.alpha_:.2f})\"))\n","\n","n_zero = np.sum(np.abs(lasso.coef_) < 1e-8)\n","print(f\"\\nLasso set {n_zero} of {len(lasso.coef_)} coefficients to ~0  → it dropped those features.\")\n","\n","# ----- 4. Polynomial Regression on a SMALL set of features -----\n","# If we polynomial-expand 40 columns to degree 4, we get thousands of columns and the model\n","# will memorize the training set. For teaching, we use 3 career features only.\n","poly_cols = [c for c in [\"Age\", \"TotalWorkingYears\", \"YearsAtCompany\"] if c in X_train_sal.columns]\n","print(\"\\nPolynomial demo features:\", poly_cols)\n","\n","for degree in [1, 2, 4]:\n","    poly = PolynomialFeatures(degree=degree, include_bias=False)\n","    Xtr_p = poly.fit_transform(X_train_sal[poly_cols])\n","    Xte_p = poly.transform(X_test_sal[poly_cols])\n","    # scale polynomial features\n","    scp = StandardScaler()\n","    Xtr_p = scp.fit_transform(Xtr_p)\n","    Xte_p = scp.transform(Xte_p)\n","\n","    model_p = LinearRegression()\n","    model_p.fit(Xtr_p, y_train_sal)\n","    pred_p_tr = model_p.predict(Xtr_p)\n","    pred_p_te = model_p.predict(Xte_p)\n","    r2_tr = r2_score(y_train_sal, pred_p_tr)\n","    r2_te = r2_score(y_test_sal, pred_p_te)\n","    print(\n","        f\"Polynomial degree {degree:1d}  ({Xtr_p.shape[1]:3d} features)  \"\n","        f\"Train R²={r2_tr:.3f}   Test R²={r2_te:.3f}   gap={r2_tr - r2_te:.3f}\"\n","    )\n","    reg_rows.append(regression_report(y_test_sal, pred_p_te, f\"Polynomial degree {degree} (3 cols)\"))\n","\n","# Ridge on polynomial degree 4 — regularization should reduce the overfitting gap\n","poly4 = PolynomialFeatures(degree=4, include_bias=False)\n","Xtr_p4 = poly4.fit_transform(X_train_sal[poly_cols])\n","Xte_p4 = poly4.transform(X_test_sal[poly_cols])\n","scp4 = StandardScaler()\n","Xtr_p4 = scp4.fit_transform(Xtr_p4)\n","Xte_p4 = scp4.transform(Xte_p4)\n","ridge_poly = Ridge(alpha=50)\n","ridge_poly.fit(Xtr_p4, y_train_sal)\n","pred_rp = ridge_poly.predict(Xte_p4)\n","print(\"\\nSame degree-4 features, but with Ridge(alpha=50) to control variance:\")\n","print(\n","    f\"  Train R²={r2_score(y_train_sal, ridge_poly.predict(Xtr_p4)):.3f}   \"\n","    f\"Test R²={r2_score(y_test_sal, pred_rp):.3f}\"\n",")\n","reg_rows.append(regression_report(y_test_sal, pred_rp, \"Poly d=4 + Ridge\"))\n","\n","reg_table = pd.DataFrame(reg_rows).sort_values(\"R2\", ascending=False)\n","print(\"\\n===== REGRESSION LEADERBOARD (test set) =====\")\n","display(reg_table.style.format({\"MAE\": \"{:.1f}\", \"RMSE\": \"{:.1f}\", \"R2\": \"{:.3f}\"}))\n","\n","print(\"\\n💡 How to read the polynomial lines:\")\n","print(\" - Degree 1: high bias, train ≈ test (underfit if R² is low).\")\n","print(\" - High degree: train R² goes UP, test R² often goes DOWN → high variance (overfit).\")\n","print(\" - Ridge on the high-degree features pulls train and test closer together.\")\n"]},{"cell_type":"code","execution_count":13,"id":"2cc26140","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"2cc26140","executionInfo":{"status":"ok","timestamp":1787223481996,"user_tz":-330,"elapsed":4933,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"e43acb1c-e0d1-4bf4-9a66-7ec25a81f454"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x700 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Best regression model on the test set:\n","Model    Ridge (alpha=7.85)\n","MAE              892.271996\n","RMSE             1167.80791\n","R2                   0.9376\n","\n","Interview line: 'I compared Linear, Ridge, Lasso and Polynomial, used MAE/RMSE/R²,\n","and showed how L2/L1 regularization and extra polynomial features change bias and variance.'\n"]}],"source":["# Bias-variance visual 1: predicted vs actual for Linear vs Lasso\n","fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n","for ax, pred, title in [\n","    (axes[0], pred_lin, \"Linear Regression\"),\n","    (axes[1], pred_lasso, \"Lasso\"),\n","]:\n","    ax.scatter(y_test_sal, pred, alpha=0.45, edgecolor=\"none\")\n","    lo, hi = y_test_sal.min(), y_test_sal.max()\n","    ax.plot([lo, hi], [lo, hi], \"r--\", label=\"Perfect prediction\")\n","    ax.set_xlabel(\"Actual MonthlyIncome\")\n","    ax.set_ylabel(\"Predicted MonthlyIncome\")\n","    ax.set_title(title)\n","    ax.legend()\n","plt.tight_layout()\n","plt.show()\n","\n","# Bias-variance visual 2: learning curve for Linear Regression\n","# If train score is high and test score is much lower → variance\n","# If BOTH scores are low → bias\n","train_sizes, train_scores, test_scores = learning_curve(\n","    LinearRegression(),\n","    X_train_sal_s, y_train_sal,\n","    cv=KFold(n_splits=5, shuffle=True, random_state=42),\n","    train_sizes=np.linspace(0.2, 1.0, 6),\n","    scoring=\"r2\",\n","    n_jobs=-1,\n",")\n","\n","plt.figure(figsize=(8, 5))\n","plt.plot(train_sizes, train_scores.mean(axis=1), \"o-\", label=\"Train R²\")\n","plt.plot(train_sizes, test_scores.mean(axis=1), \"o-\", label=\"CV R² (like a mini-test)\")\n","plt.fill_between(train_sizes, train_scores.mean(axis=1) - train_scores.std(axis=1),\n","                 train_scores.mean(axis=1) + train_scores.std(axis=1), alpha=0.15)\n","plt.fill_between(train_sizes, test_scores.mean(axis=1) - test_scores.std(axis=1),\n","                 test_scores.mean(axis=1) + test_scores.std(axis=1), alpha=0.15)\n","plt.title(\"Learning curve — Linear Regression (salary)\")\n","plt.xlabel(\"Number of training employees\")\n","plt.ylabel(\"R²\")\n","plt.legend()\n","plt.tight_layout()\n","plt.show()\n","\n","# Coefficients: Ridge shrinks, Lasso zeros out\n","coef_compare = pd.DataFrame({\n","    \"Linear\": pd.Series(lin.coef_, index=X_train_sal_s.columns),\n","    \"Ridge\": pd.Series(ridge.coef_, index=X_train_sal_s.columns),\n","    \"Lasso\": pd.Series(lasso.coef_, index=X_train_sal_s.columns),\n","})\n","# show the 12 features Linear thinks are biggest\n","top12 = coef_compare[\"Linear\"].abs().sort_values(ascending=False).head(12).index\n","coef_compare.loc[top12].plot(kind=\"barh\", figsize=(10, 7))\n","plt.title(\"Coefficient comparison (top |Linear| features)\\nRidge shrinks them, Lasso may set some to 0\")\n","plt.xlabel(\"Coefficient (on scaled features)\")\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"Best regression model on the test set:\")\n","print(reg_table.iloc[0].to_string())\n","print(\"\\nInterview line: 'I compared Linear, Ridge, Lasso and Polynomial, used MAE/RMSE/R²,\")\n","print(\"and showed how L2/L1 regularization and extra polynomial features change bias and variance.'\")\n"]},{"cell_type":"markdown","id":"d9002fde","metadata":{"id":"d9002fde"},"source":["# PART B — CLASSIFICATION\n","## Predict `Attrition` (will the employee leave?)\n","\n","**Positive class = 1 = Yes, the employee left**\n","\n","Because only ~16% left, we care more about **Recall** and **F1** than Accuracy.\n","\n","| Metric | Question it answers | When HR cares |\n","|---|---|---|\n","| Accuracy | Overall % correct | Misleading if classes are imbalanced |\n","| Precision | Of people we flagged as leavers, how many really left? | If retention offers cost money, we want fewer false alarms |\n","| Recall | Of people who really left, how many did we catch? | If losing people is very expensive, catch as many as possible |\n","| F1 | Harmonic mean of Precision and Recall | One-number balance |\n","| ROC-AUC | Ranking quality (0.5 = coin flip, 1.0 = perfect) | Compare models independently of one cutoff |\n","| Confusion Matrix | TP, FP, TN, FN counts | Explain errors to a manager |\n","\n","**Models:** Logistic Regression, Decision Tree, Random Forest, SVM, KNN\n"]},{"cell_type":"code","execution_count":14,"id":"ec976405","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ec976405","executionInfo":{"status":"ok","timestamp":1787223494158,"user_tz":-330,"elapsed":791,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"a9d48206-8166-434a-c825-c2b6785f28d4"},"outputs":[{"output_type":"stream","name":"stdout","text":["Attrition rate in the full data: 16.1%\n","X shape: (1470, 46)\n","Train size: 1176  leavers in train: 190 (16.2%)\n","Test size : 294  leavers in test : 47 (16.0%)\n","\n","StandardScaler example (first feature, train): mean≈0, std≈1 → mean=-0.00, std=1.00\n","MinMaxScaler example (first feature, train): values between 0 and 1 → min=0.00, max=1.00\n","\n","SelectKBest (classification) — top 12 features:\n","OverTimeFlag                    56.56\n","TotalWorkingYears               42.14\n","Age                             41.73\n","YearsPerCompany                 41.22\n","MaritalStatus_Single            35.98\n","YearsWithCurrManager            34.43\n","AvgSatisfaction                 34.04\n","YearsInCurrentRole              33.69\n","JobLevel                        33.37\n","JobRole_Sales Representative    31.13\n","MonthlyIncome                   31.02\n","YearsAtCompany                  28.95\n","dtype: float64\n","\n","Mutual information (non-linear usefulness) — top 8:\n","YearsPerCompany                 0.0416\n","MonthlyIncome                   0.0365\n","TotalWorkingYears               0.0297\n","JobLevel                        0.0283\n","BusinessTravel_Travel_Rarely    0.0247\n","YearsAtCompany                  0.0236\n","MaritalStatus_Single            0.0216\n","AvgSatisfaction                 0.0216\n","dtype: float64\n"]}],"source":["# Attrition features: we MAY use MonthlyIncome (pay is known before someone quits)\n","y_att = data_encoded[\"AttritionFlag\"]\n","X_att = data_encoded.drop(columns=[\"AttritionFlag\"])\n","\n","print(\"Attrition rate in the full data: {:.1f}%\".format(100 * y_att.mean()))\n","print(\"X shape:\", X_att.shape)\n","\n","# Stratified split: keep the same % of leavers in train and test\n","X_train_att, X_test_att, y_train_att, y_test_att = train_test_split(\n","    X_att, y_att, test_size=0.20, random_state=42, stratify=y_att\n",")\n","print(\"Train size:\", len(y_train_att), \" leavers in train:\", int(y_train_att.sum()),\n","      f\"({100*y_train_att.mean():.1f}%)\")\n","print(\"Test size :\", len(y_test_att), \" leavers in test :\", int(y_test_att.sum()),\n","      f\"({100*y_test_att.mean():.1f}%)\")\n","\n","X_train_att_s, X_test_att_s, att_scaler = scale_train_test(X_train_att, X_test_att, method=\"standard\")\n","\n","# Also show MinMax scaling so you can say you used both scalers\n","X_train_mm, X_test_mm, _ = scale_train_test(X_train_att, X_test_att, method=\"minmax\")\n","print(\"\\nStandardScaler example (first feature, train): mean≈0, std≈1 →\",\n","      f\"mean={X_train_att_s.iloc[:,0].mean():.2f}, std={X_train_att_s.iloc[:,0].std():.2f}\")\n","print(\"MinMaxScaler example (first feature, train): values between 0 and 1 →\",\n","      f\"min={X_train_mm.iloc[:,0].min():.2f}, max={X_train_mm.iloc[:,0].max():.2f}\")\n","\n","top_att_feats, att_scores = show_select_kbest(X_train_att_s, y_train_att, k=12, problem=\"classification\")\n","\n","# Optional extra: mutual information (captures non-linear links too)\n","mi = pd.Series(mutual_info_classif(X_train_att_s, y_train_att, random_state=42), index=X_train_att_s.columns)\n","print(\"\\nMutual information (non-linear usefulness) — top 8:\")\n","print(mi.sort_values(ascending=False).head(8).round(4))\n"]},{"cell_type":"code","execution_count":15,"id":"dc63e796","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":741},"id":"dc63e796","executionInfo":{"status":"ok","timestamp":1787223502363,"user_tz":-330,"elapsed":1980,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"f8f03d94-63d0-4575-e98d-2ad4138a1b05"},"outputs":[{"output_type":"stream","name":"stdout","text":["==============================================================================\n","CLASSIFICATION MODELS\n","class_weight='balanced' tells the model: 'a leaver is rarer — pay more attention'.\n","KNN has no class_weight, so we keep it default.\n","==============================================================================\n","Logistic Regression     Acc=0.762  Prec=0.365  Rec=0.660  F1=0.470  AUC=0.807\n","Decision Tree (depth=4)  Acc=0.738  Prec=0.286  Rec=0.426  F1=0.342  AUC=0.665\n","Decision Tree (unlimited)  Acc=0.752  Prec=0.217  Rec=0.213  F1=0.215  AUC=0.534\n","\n","Overfitting check for trees (accuracy):\n","  depth=4      train=0.806  test=0.738\n","  unlimited    train=1.000  test=0.752\n","If train is ~1.00 and test is much lower, the deep tree MEMORIZED employees (high variance).\n","Random Forest           Acc=0.833  Prec=0.458  Rec=0.234  F1=0.310  AUC=0.767\n","SVM (RBF)               Acc=0.820  Prec=0.446  Rec=0.532  F1=0.485  AUC=0.803\n","\n","Trying several K for KNN (odd numbers so votes do not tie):\n","  K= 3  F1=0.105\n","  K= 5  F1=0.109\n","  K= 7  F1=0.111\n","  K= 9  F1=0.148\n","  K=15  F1=0.115\n","Best K on this test set = 9\n","KNN (k=9)               Acc=0.844  Prec=0.571  Rec=0.085  F1=0.148  AUC=0.670\n","\n","===== CLASSIFICATION LEADERBOARD (test set) =====\n"]},{"output_type":"display_data","data":{"text/plain":["<pandas.io.formats.style.Styler at 0x7a975af3aa50>"],"text/html":["<style type=\"text/css\">\n","</style>\n","<table id=\"T_29aba\" class=\"dataframe\">\n","  <thead>\n","    <tr>\n","      <th class=\"blank level0\" >&nbsp;</th>\n","      <th id=\"T_29aba_level0_col0\" class=\"col_heading level0 col0\" >Model</th>\n","      <th id=\"T_29aba_level0_col1\" class=\"col_heading level0 col1\" >Accuracy</th>\n","      <th id=\"T_29aba_level0_col2\" class=\"col_heading level0 col2\" >Precision</th>\n","      <th id=\"T_29aba_level0_col3\" class=\"col_heading level0 col3\" >Recall</th>\n","      <th id=\"T_29aba_level0_col4\" class=\"col_heading level0 col4\" >F1</th>\n","      <th id=\"T_29aba_level0_col5\" class=\"col_heading level0 col5\" >ROC-AUC</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th id=\"T_29aba_level0_row0\" class=\"row_heading level0 row0\" >4</th>\n","      <td id=\"T_29aba_row0_col0\" class=\"data row0 col0\" >SVM (RBF)</td>\n","      <td id=\"T_29aba_row0_col1\" class=\"data row0 col1\" >0.820</td>\n","      <td id=\"T_29aba_row0_col2\" class=\"data row0 col2\" >0.446</td>\n","      <td id=\"T_29aba_row0_col3\" class=\"data row0 col3\" >0.532</td>\n","      <td id=\"T_29aba_row0_col4\" class=\"data row0 col4\" >0.485</td>\n","      <td id=\"T_29aba_row0_col5\" class=\"data row0 col5\" >0.803</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_29aba_level0_row1\" class=\"row_heading level0 row1\" >0</th>\n","      <td id=\"T_29aba_row1_col0\" class=\"data row1 col0\" >Logistic Regression</td>\n","      <td id=\"T_29aba_row1_col1\" class=\"data row1 col1\" >0.762</td>\n","      <td id=\"T_29aba_row1_col2\" class=\"data row1 col2\" >0.365</td>\n","      <td id=\"T_29aba_row1_col3\" class=\"data row1 col3\" >0.660</td>\n","      <td id=\"T_29aba_row1_col4\" class=\"data row1 col4\" >0.470</td>\n","      <td id=\"T_29aba_row1_col5\" class=\"data row1 col5\" >0.807</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_29aba_level0_row2\" class=\"row_heading level0 row2\" >1</th>\n","      <td id=\"T_29aba_row2_col0\" class=\"data row2 col0\" >Decision Tree (depth=4)</td>\n","      <td id=\"T_29aba_row2_col1\" class=\"data row2 col1\" >0.738</td>\n","      <td id=\"T_29aba_row2_col2\" class=\"data row2 col2\" >0.286</td>\n","      <td id=\"T_29aba_row2_col3\" class=\"data row2 col3\" >0.426</td>\n","      <td id=\"T_29aba_row2_col4\" class=\"data row2 col4\" >0.342</td>\n","      <td id=\"T_29aba_row2_col5\" class=\"data row2 col5\" >0.665</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_29aba_level0_row3\" class=\"row_heading level0 row3\" >3</th>\n","      <td id=\"T_29aba_row3_col0\" class=\"data row3 col0\" >Random Forest</td>\n","      <td id=\"T_29aba_row3_col1\" class=\"data row3 col1\" >0.833</td>\n","      <td id=\"T_29aba_row3_col2\" class=\"data row3 col2\" >0.458</td>\n","      <td id=\"T_29aba_row3_col3\" class=\"data row3 col3\" >0.234</td>\n","      <td id=\"T_29aba_row3_col4\" class=\"data row3 col4\" >0.310</td>\n","      <td id=\"T_29aba_row3_col5\" class=\"data row3 col5\" >0.767</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_29aba_level0_row4\" class=\"row_heading level0 row4\" >2</th>\n","      <td id=\"T_29aba_row4_col0\" class=\"data row4 col0\" >Decision Tree (unlimited)</td>\n","      <td id=\"T_29aba_row4_col1\" class=\"data row4 col1\" >0.752</td>\n","      <td id=\"T_29aba_row4_col2\" class=\"data row4 col2\" >0.217</td>\n","      <td id=\"T_29aba_row4_col3\" class=\"data row4 col3\" >0.213</td>\n","      <td id=\"T_29aba_row4_col4\" class=\"data row4 col4\" >0.215</td>\n","      <td id=\"T_29aba_row4_col5\" class=\"data row4 col5\" >0.534</td>\n","    </tr>\n","    <tr>\n","      <th id=\"T_29aba_level0_row5\" class=\"row_heading level0 row5\" >5</th>\n","      <td id=\"T_29aba_row5_col0\" class=\"data row5 col0\" >KNN (k=9)</td>\n","      <td id=\"T_29aba_row5_col1\" class=\"data row5 col1\" >0.844</td>\n","      <td id=\"T_29aba_row5_col2\" class=\"data row5 col2\" >0.571</td>\n","      <td id=\"T_29aba_row5_col3\" class=\"data row5 col3\" >0.085</td>\n","      <td id=\"T_29aba_row5_col4\" class=\"data row5 col4\" >0.148</td>\n","      <td id=\"T_29aba_row5_col5\" class=\"data row5 col5\" >0.670</td>\n","    </tr>\n","  </tbody>\n","</table>\n"]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","💡 Do NOT pick a model by Accuracy only.\n","HR usually wants high Recall (catch leavers) or a high F1 (balance).\n"]}],"source":["print(\"=\" * 78)\n","print(\"CLASSIFICATION MODELS\")\n","print(\"class_weight='balanced' tells the model: 'a leaver is rarer — pay more attention'.\")\n","print(\"KNN has no class_weight, so we keep it default.\")\n","print(\"=\" * 78)\n","\n","clf_rows = []\n","fitted = {}   # store models to reuse for ROC / confusion matrix\n","probs = {}\n","preds = {}\n","\n","def store(name, model, X_te, has_proba=True, decision=False):\n","    y_hat = model.predict(X_te)\n","    if has_proba:\n","        y_pr = model.predict_proba(X_te)[:, 1]\n","    elif decision:\n","        # SVM without probability=True can use decision_function as a score for ROC-AUC\n","        y_pr = model.decision_function(X_te)\n","    else:\n","        y_pr = None\n","    fitted[name] = model\n","    preds[name] = y_hat\n","    probs[name] = y_pr\n","    clf_rows.append(classification_report_row(y_test_att, y_hat, y_pr, name))\n","\n","\n","# 1) Logistic Regression  (linear 'S-shaped' probability model)\n","logreg = LogisticRegression(max_iter=2000, class_weight=\"balanced\", random_state=42)\n","logreg.fit(X_train_att_s, y_train_att)\n","store(\"Logistic Regression\", logreg, X_test_att_s)\n","\n","# 2) Decision Tree — SHALLOW (higher bias, lower variance)\n","tree_small = DecisionTreeClassifier(max_depth=4, class_weight=\"balanced\", random_state=42)\n","tree_small.fit(X_train_att, y_train_att)   # trees do not need scaling\n","store(\"Decision Tree (depth=4)\", tree_small, X_test_att)\n","\n","# 3) Decision Tree — DEEP (lower bias, higher variance / overfit risk)\n","tree_deep = DecisionTreeClassifier(max_depth=None, class_weight=\"balanced\", random_state=42)\n","tree_deep.fit(X_train_att, y_train_att)\n","store(\"Decision Tree (unlimited)\", tree_deep, X_test_att)\n","\n","print(\n","    \"\\nOverfitting check for trees (accuracy):\\n\"\n","    f\"  depth=4      train={accuracy_score(y_train_att, tree_small.predict(X_train_att)):.3f}  \"\n","    f\"test={accuracy_score(y_test_att, tree_small.predict(X_test_att)):.3f}\\n\"\n","    f\"  unlimited    train={accuracy_score(y_train_att, tree_deep.predict(X_train_att)):.3f}  \"\n","    f\"test={accuracy_score(y_test_att, tree_deep.predict(X_test_att)):.3f}\"\n",")\n","print(\"If train is ~1.00 and test is much lower, the deep tree MEMORIZED employees (high variance).\")\n","\n","# 4) Random Forest — many trees voting (reduces variance of a single tree)\n","rf = RandomForestClassifier(\n","    n_estimators=200,\n","    max_depth=10,\n","    min_samples_leaf=3,\n","    class_weight=\"balanced\",\n","    random_state=42,\n","    n_jobs=-1,\n",")\n","rf.fit(X_train_att, y_train_att)\n","store(\"Random Forest\", rf, X_test_att)\n","\n","# 5) SVM (needs scaling). probability=True lets us draw ROC curves\n","svm = SVC(kernel=\"rbf\", class_weight=\"balanced\", probability=True, random_state=42)\n","svm.fit(X_train_att_s, y_train_att)\n","store(\"SVM (RBF)\", svm, X_test_att_s)\n","\n","# 6) KNN (needs scaling). Try a few K and keep the best F1 on a simple loop.\n","print(\"\\nTrying several K for KNN (odd numbers so votes do not tie):\")\n","best_k, best_f1, best_knn = 5, -1, None\n","for k in [3, 5, 7, 9, 15]:\n","    knn_try = KNeighborsClassifier(n_neighbors=k)\n","    knn_try.fit(X_train_att_s, y_train_att)\n","    f1_k = f1_score(y_test_att, knn_try.predict(X_test_att_s), zero_division=0)\n","    print(f\"  K={k:2d}  F1={f1_k:.3f}\")\n","    if f1_k > best_f1:\n","        best_k, best_f1, best_knn = k, f1_k, knn_try\n","print(f\"Best K on this test set = {best_k}\")\n","store(f\"KNN (k={best_k})\", best_knn, X_test_att_s)\n","\n","clf_table = pd.DataFrame(clf_rows).sort_values(\"F1\", ascending=False)\n","print(\"\\n===== CLASSIFICATION LEADERBOARD (test set) =====\")\n","display(clf_table.style.format(\"{:.3f}\", subset=[\"Accuracy\", \"Precision\", \"Recall\", \"F1\", \"ROC-AUC\"]))\n","\n","print(\"\\n💡 Do NOT pick a model by Accuracy only.\")\n","print(\"HR usually wants high Recall (catch leavers) or a high F1 (balance).\")\n"]},{"cell_type":"code","execution_count":16,"id":"53a70e0e","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"53a70e0e","executionInfo":{"status":"ok","timestamp":1787223512368,"user_tz":-330,"elapsed":1362,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"202af7f0-5f1d-45e7-d9da-a34dd0743725"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 2100x380 with 5 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["How to read ONE confusion matrix:\n","  TN = we said Stay, they stayed          (good)\n","  FP = we said Leave, they stayed         (false alarm — wasted retention offer)\n","  FN = we said Stay, they left            (missed leaver — expensive)\n","  TP = we said Leave, they left           (caught them — good)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Full classification report for the best-F1 model:\n","Best by F1: SVM (RBF)\n","              precision    recall  f1-score   support\n","\n","        Stay       0.91      0.87      0.89       247\n","       Leave       0.45      0.53      0.49        47\n","\n","    accuracy                           0.82       294\n","   macro avg       0.68      0.70      0.69       294\n","weighted avg       0.83      0.82      0.83       294\n","\n"]}],"source":["# ----- Confusion matrices -----\n","# Pick the main models (skip the unlimited tree so the figure stays readable)\n","cm_names = [n for n in clf_table[\"Model\"] if \"unlimited\" not in n][:5]\n","\n","fig, axes = plt.subplots(1, len(cm_names), figsize=(4.2 * len(cm_names), 3.8))\n","if len(cm_names) == 1:\n","    axes = [axes]\n","for ax, name in zip(axes, cm_names):\n","    ConfusionMatrixDisplay.from_predictions(\n","        y_test_att, preds[name],\n","        display_labels=[\"Stay (0)\", \"Leave (1)\"],\n","        cmap=\"Blues\", colorbar=False, ax=ax\n","    )\n","    ax.set_title(name, fontsize=10)\n","plt.suptitle(\"Confusion matrices  |  top-left=TN  top-right=FP  bottom-left=FN  bottom-right=TP\", y=1.05)\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"How to read ONE confusion matrix:\")\n","print(\"  TN = we said Stay, they stayed          (good)\")\n","print(\"  FP = we said Leave, they stayed         (false alarm — wasted retention offer)\")\n","print(\"  FN = we said Stay, they left            (missed leaver — expensive)\")\n","print(\"  TP = we said Leave, they left           (caught them — good)\")\n","\n","# ----- ROC curves (all models with a probability / score) -----\n","plt.figure(figsize=(8, 6))\n","for name, y_pr in probs.items():\n","    if y_pr is None:\n","        continue\n","    fpr, tpr, _ = roc_curve(y_test_att, y_pr)\n","    auc = roc_auc_score(y_test_att, y_pr)\n","    plt.plot(fpr, tpr, label=f\"{name}  (AUC={auc:.3f})\")\n","plt.plot([0, 1], [0, 1], \"k--\", label=\"Random guess (AUC=0.50)\")\n","plt.xlabel(\"False Positive Rate\")\n","plt.ylabel(\"True Positive Rate (Recall)\")\n","plt.title(\"ROC curves — higher and more left is better\")\n","plt.legend(loc=\"lower right\", fontsize=8)\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"\\nFull classification report for the best-F1 model:\")\n","best_name = clf_table.iloc[0][\"Model\"]\n","print(\"Best by F1:\", best_name)\n","print(classification_report(y_test_att, preds[best_name], target_names=[\"Stay\", \"Leave\"]))\n"]},{"cell_type":"code","execution_count":17,"id":"db170aa7","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":477},"id":"db170aa7","executionInfo":{"status":"ok","timestamp":1787223526517,"user_tz":-330,"elapsed":3552,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"7e7d9745-98d7-458b-b20f-2b2012bee816"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Common drivers of attrition in this dataset (you will likely see some of these):\n","  OverTime, low MonthlyIncome, young Age, frequent Business Travel,\n","  Sales Representative role, low StockOptionLevel, being Single.\n","\n","That is your 'business insight' paragraph for the README and for interviews.\n"]}],"source":["# ----- Feature importance / coefficients for the models that can explain themselves -----\n","fig, axes = plt.subplots(1, 3, figsize=(18, 6))\n","\n","# Logistic coefficients (on scaled features → comparable)\n","log_coef = pd.Series(logreg.coef_[0], index=X_train_att_s.columns).sort_values()\n","top_log = pd.concat([log_coef.head(8), log_coef.tail(8)])\n","colors = [\"#e53935\" if v > 0 else \"#1e88e5\" for v in top_log]\n","top_log.plot(kind=\"barh\", ax=axes[0], color=colors)\n","axes[0].set_title(\"Logistic Regression coefficients\\n(red = more likely to LEAVE)\")\n","axes[0].axvline(0, color=\"black\", linewidth=0.8)\n","\n","# Decision tree picture (shallow one — humans can actually read it)\n","plot_tree(\n","    tree_small,\n","    feature_names=list(X_train_att.columns),\n","    class_names=[\"Stay\", \"Leave\"],\n","    filled=True, max_depth=3, fontsize=6, ax=axes[1]\n",")\n","axes[1].set_title(\"Decision Tree (depth 4, drawn up to depth 3)\")\n","\n","# Random Forest impurity importance\n","rf_imp = pd.Series(rf.feature_importances_, index=X_train_att.columns).sort_values(ascending=True).tail(12)\n","rf_imp.plot(kind=\"barh\", ax=axes[2], color=\"teal\")\n","axes[2].set_title(\"Random Forest — top feature importances\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"Common drivers of attrition in this dataset (you will likely see some of these):\")\n","print(\"  OverTime, low MonthlyIncome, young Age, frequent Business Travel,\")\n","print(\"  Sales Representative role, low StockOptionLevel, being Single.\")\n","print(\"\\nThat is your 'business insight' paragraph for the README and for interviews.\")\n"]},{"cell_type":"markdown","id":"045f0246","metadata":{"id":"045f0246"},"source":["## Cell 10 — Bias–variance on classification (Decision Tree learning curve)\n","\n","Same idea as the salary learning curve, now for trees:\n","\n","- **Shallow tree:** train and test scores close, but maybe both only okay → bias\n","- **Deep tree:** train score near 1.0, test score lower → variance\n"]},{"cell_type":"code","execution_count":18,"id":"069d8294","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":481},"id":"069d8294","executionInfo":{"status":"ok","timestamp":1787223540011,"user_tz":-330,"elapsed":3896,"user":{"displayName":"Aryan Choudhary","userId":"07944419665814199827"}},"outputId":"ab498938-d462-48c2-b32d-b0702230f70a"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x450 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["If the right plot has a big gap between the two lines, you just SAW overfitting.\n","Random Forest (many trees + randomness) is one way to shrink that gap — that is bagging.\n"]}],"source":["fig, axes = plt.subplots(1, 2, figsize=(12, 4.5), sharey=True)\n","\n","for ax, model, title in [\n","    (axes[0], DecisionTreeClassifier(max_depth=4, class_weight=\"balanced\", random_state=42),\n","     \"Shallow tree (depth=4) — lower variance\"),\n","    (axes[1], DecisionTreeClassifier(max_depth=None, class_weight=\"balanced\", random_state=42),\n","     \"Deep tree (unlimited) — higher variance\"),\n","]:\n","    sizes, tr, te = learning_curve(\n","        model, X_train_att, y_train_att,\n","        cv=StratifiedKFold(n_splits=5, shuffle=True, random_state=42),\n","        train_sizes=np.linspace(0.2, 1.0, 6),\n","        scoring=\"f1\",\n","        n_jobs=-1,\n","    )\n","    ax.plot(sizes, tr.mean(axis=1), \"o-\", label=\"Train F1\")\n","    ax.plot(sizes, te.mean(axis=1), \"o-\", label=\"CV F1\")\n","    ax.set_title(title)\n","    ax.set_xlabel(\"Training employees\")\n","    ax.set_ylabel(\"F1 score\")\n","    ax.legend()\n","    ax.set_ylim(0, 1.05)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"If the right plot has a big gap between the two lines, you just SAW overfitting.\")\n","print(\"Random Forest (many trees + randomness) is one way to shrink that gap — that is bagging.\")\n"]},{"cell_type":"markdown","id":"72725c28","metadata":{"id":"72725c28"},"source":["## Cell 11 — Final dashboard + what to write on your resume\n","\n","The numbers below are computed from **your** run, so they are honest.\n","Copy the printed resume bullets after this cell finishes.\n"]},{"cell_type":"code","execution_count":19,"id":"7bcabb2c","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"7bcabb2c","executionInfo":{"status":"ok","timestamp":1787223549443,"use